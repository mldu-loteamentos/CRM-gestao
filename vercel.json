{
  "functions": {
    "api/gateway.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?path=:path*" },
    { "source": "/proxy-storage/:path*", "destination": "https://firebasestorage.googleapis.com/v0/b/crm-gestao-mldu.firebasestorage.app/o/:path*" }
  ],
  "crons": [
    {
      "path": "/api/morning-warmup",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/estoque-batimento",
      "schedule": "0 10 * * *"
    }
  ]
}
