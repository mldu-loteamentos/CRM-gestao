{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/sienge-proxy/:path*", "destination": "/api/sienge-proxy" },
    { "source": "/api/participacoes/:path*", "destination": "/api/participacoes" },
    { "source": "/proxy-storage/:path*", "destination": "https://firebasestorage.googleapis.com/v0/b/crm-gestao-mldu.firebasestorage.app/o/:path*" }
  ],
  "crons": [
    {
      "path": "/api/morning-warmup",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/estoque-batimento",
      "schedule": "30 10 * * 1-5"
    }
  ]
}
